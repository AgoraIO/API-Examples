{
  "version": 1,
  "sdk_version_sources": {
    "android": [
      {
        "path": "Android/APIExample/gradle.properties",
        "kind": "gradle-property",
        "key": "rtc_sdk_version"
      }
    ],
    "ios": [
      {
        "path": "iOS/APIExample/Podfile",
        "kind": "external-injection",
        "reason": "The RTC SDK frameworks are injected outside the repository, so their version cannot be verified from tracked project files."
      }
    ],
    "macos": [
      {
        "path": "macOS/Podfile",
        "kind": "cocoapods",
        "package": "AgoraRtcEngine_macOS"
      }
    ],
    "windows": [
      {
        "path": "windows/APIExample/install.ps1",
        "kind": "archive-name",
        "prefix": "Agora_Native_SDK_for_Windows_v",
        "suffix": "_FULL.zip"
      }
    ]
  }
}
